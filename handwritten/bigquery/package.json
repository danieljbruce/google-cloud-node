{
  "name": "@google-cloud/bigquery",
  "description": "Google BigQuery Client Library for Node.js",
  "version": "9.0.3",
  "license": "Apache-2.0",
  "author": "Google LLC",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "directory": "handwritten/bigquery",
    "url": "https://github.com/googleapis/google-cloud-node.git"
  },
  "main": "./build/src/index.js",
  "types": "./build/src/index.d.ts",
  "files": [
    "build/src",
    "!build/src/**/*.map"
  ],
  "keywords": [
    "google apis client",
    "google api client",
    "google apis",
    "google api",
    "google",
    "google cloud platform",
    "google cloud",
    "cloud",
    "google bigquery",
    "bigquery"
  ],
  "scripts": {
    "prebenchmark": "npm run compile",
    "benchmark": "node build/benchmark/bench.js benchmark/queries.json",
    "docs": "jsdoc -c .jsdoc.js",
    "lint": "gts check",
    "samples-test": "cd samples/ && npm link ../ && npm test && cd ../",
    "test": "jest --coverage",
    "system-test": "mocha build/system-test --timeout 600000",
    "presystem-test": "npm run compile",
    "clean": "gts clean",
    "compile": "tsc -p . && cp src/types.d.ts build/src/",
    "fix": "gts fix",
    "predocs": "npm run compile",
    "prepare": "npm run compile",
    "pretest": "npm run compile",
    "types": "node scripts/gen-types.js",
    "prelint": "cd samples; npm link ../; npm install",
    "precompile": "gts clean"
  },
  "dependencies": {
    "@google-cloud/common": "^8.0.0",
    "@google-cloud/paginator": "^7.0.0",
    "@google-cloud/precise-date": "^6.0.0",
    "@google-cloud/promisify": "^6.0.0",
    "teeny-request": "^11.0.0",
    "arrify": "^3.0.0",
    "big.js": "^7.0.0",
    "duplexify": "^4.1.3",
    "extend": "^3.0.2",
    "stream-events": "^1.0.5"
  },
  "overrides": {
    "@google-cloud/common": {
      "google-auth-library": "10.3.0"
    }
  },
  "devDependencies": {
    "@google-cloud/storage": "^7.16.0",
    "@types/big.js": "^6.2.2",
    "@types/duplexify": "^3.6.4",
    "@types/extend": "^3.0.4",
    "@types/is": "^0.0.25",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.14.0",
    "discovery-tsd": "^0.3.0",
    "eslint-plugin-prettier": "^5.2.6",
    "gts": "^6.0.2",
    "jest": "^29.7.0",
    "jsdoc": "^4.0.4",
    "jsdoc-fresh": "^6.0.0",
    "jsdoc-region-tag": "^5.0.0",
    "pack-n-play": "^5.0.0",
    "path-to-regexp": "^8.2.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.4.10",
    "typescript": "^5.8.2"
  },
  "homepage": "https://github.com/googleapis/google-cloud-node/tree/main/handwritten/bigquery"
}
